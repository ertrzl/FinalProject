# Copy this file to ".env" (same folder) and replace the values. ".env" holds secrets and is ignored by git:
# never commit it. "docker compose" reads it automatically.

# Password of the database administrator ("sa"). SQL Server rejects weak ones and then does not start: use at least 8
# characters with an upper-case letter, a lower-case letter, a digit and a symbol. Do not use ; ' " or $ in it, because
# it is also placed inside the connection string. Example shape: Str0ng!Passw0rd
SA_PASSWORD=ChangeMe!Str0ngPassw0rd

# The key that signs login tokens: any random text of at least 32 characters (no spaces). Generate one, for example with
#   openssl rand -base64 48
JWT_SECRET_KEY=replace-this-with-a-long-random-text-of-at-least-32-chars

# The e-mail address that becomes the administrator. Register this address on the site, then sign in with it.
ADMIN_EMAIL=you@example.com

# The address people type to open the site. Used in the links inside e-mails. Behind a domain or a tunnel use that
# address (for example https://social.example.com). Optional: the default is http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional. Production (the default) or Development (adds the Swagger page).
ASPNETCORE_ENVIRONMENT=Production

# Optional. A licence key for AutoMapper (the free Community key is enough). Leave empty if you have none.
AUTOMAPPER_LICENSE_KEY=
