<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Loc.T("key"): the texts shown to a person come from the language files of the Application project. -->
    <Using Include="SocialNetworkPlatformProject.Application.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddIdentity<TUser,TRole>() ships in the ASP.NET Core shared framework, not as a
         standalone NuGet package — needed here because this is a plain class library. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MailKit (Infrastructure) and Microsoft.Data.SqlClient (Persistence) bring an older System.Security.Cryptography.Pkcs
         with known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): this direct reference lifts it to the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\SocialNetworkPlatformProject.Application\SocialNetworkPlatformProject.Application.csproj" />
  </ItemGroup>

</Project>
